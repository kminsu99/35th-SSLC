#github 저장소 연결, 이름 "origin"
    git remote add origin https://github.com/kminsu99/35th-SSLC.git
   
#현재 로컬 branch "main"을 업로드
 // git branch -M main
    git push -u origin main


#브랜치 이동
    #switch
    용도 : 브랜치 이동
        #브랜치명
        git switch branch_name
        #커밋id(ex : 84b0849)
        git switch --detach 84b0
        #브랜치 생성 후 이동
        git switch -c branch_name

    #checkout
    용도 : 브랜치 이동 + 커밋 이동 + 파일복
        #브랜치명
        git checkout branch_name
        #커밋id
        git checkout 84b0

-> checkout은 기능을 다가짐, 기능과다해서 기능을 분리함
브랜치 이동 : switch
파일 복원 : restore

#커밋 취소 + 변경 내용 staged 유지
git reset --soft HEAD~1

커밋 취소 + 변경 내용 unstaged
git reset --mixed HEAD~1

git reset --hard HEAD~1
커밋 취소 + 변경 내용까지 삭제 ⚠️