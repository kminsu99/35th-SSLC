# 가상환경 생성
	python -m venv .venv          
# 가상환경 활성화 (venv폴더가 존재하는 공간에서 반드시)
[ Windows: ]
	.venv\Scripts\activate
[ Mac/Linux: ]
	source .venv/bin/activate
# 가상환경 종료
deactivate

가상환경에서 파이썬 코드 VS매크로로 실행후 dir위치 확인

#pip 설치 리스트 txt파일로 내보내기
pip freeze > requirements.txt
#설치 리스트 txt파일로 라이브러리 설치
pip install -r requirements.txt